# Undercurrent secrets (Section 11). Copy to .env for local runs.
# In production these live in Render env vars; RENDER_TRIGGER_TOKEN is
# additionally a GitHub Actions repo secret. Never commit the real .env.

# --- required: database ---
# Supabase project -> Settings -> API
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- required: delivery ---
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Public server invite, shown as the join button on the landing page.
# Discord -> Server Settings -> Invites, or right-click channel -> Invite People.
# Make it a non-expiring invite, or the button breaks after a week.
DISCORD_INVITE_URL=

# --- required: LLM (set at least one; both is better) ---
# With two keys the pipeline round-robins across providers and fails over on
# quota errors, so neither free tier drains on its own.
# https://console.groq.com/keys      (faster: ~1.5s vs ~13.7s on extraction)
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_PROVIDER=auto   # auto | gemini | groq

# --- required: trigger auth ---
# Any long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"
RENDER_TRIGGER_TOKEN=

# --- optional: sources degrade gracefully without these ---
# https://www.reddit.com/prefs/apps -> create app -> type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=undercurrent/0.1 by /u/YOURNAME

# https://github.com/settings/tokens -> fine-grained token, public repo read only
GITHUB_TOKEN=

# https://developer.x.com -> project -> Bearer Token
# NOTE: v2 reads are no longer available on the free tier -- every endpoint
# returns 402 "credits depleted". Leave unset for a $0 build; the collector
# skips itself and logs the reason.
X_BEARER_TOKEN=

# --- optional tuning (defaults in config.py are fine) ---
# LLM_MAX_OUTPUT_TOKENS=16384   # Gemini 3.x bills its reasoning against this
# LOG_LEVEL=INFO
# LLM_BATCH_SIZE=25
# LLM_MAX_EXTRACTION_CALLS=12
